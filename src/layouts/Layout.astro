---
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>From St. James to Santiago</title>

		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
        <link rel="stylesheet" href="./css/flip.min.css" />

	</head>
	<body>
		<audio id="piano-audio" src="/audio/piano-loop.mp3" autoplay loop></audio>
		<button class="loop">switch</button>
		<Header />
		<main class="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.loop {
		position: fixed;
		top: 1rem;
		right: 1rem;
		z-index: 1000;
		background-color: #fff;
		border: none;
		padding: 0.5rem 1rem;
		cursor: pointer;
	}
</style>

<script>
	document.querySelector('.loop').addEventListener('click', () => {
		const audio = document.getElementById('piano-audio');
		if (audio.paused) {
			audio.play();
		} else {
			audio.pause();
		}
	});
</script>