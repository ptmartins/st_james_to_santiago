---
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>From St. James to Santiago</title>

		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
        <link rel="stylesheet" href="./css/flip.min.css" />

	</head>
	<body>
		<audio id="piano-audio" src="/audio/piano-loop.mp3" loop></audio>
		<button class="loop material-symbols-outlined" title="Toggle background music">brand_awareness</button>
		<Header />
		<main class="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.loop {
		align-items: center;
		background-color: #464646;
		border: none;
		border-radius: 50%;
		color: var(--white);
		cursor: pointer;
		display: flex;
		font-size: 2.1rem;
		height: 48px;
		justify-content: center;
		padding: 0.5rem 1rem;
		position: fixed;
		right: 3rem;
		top: 4.5rem;
		width: 48px;
		z-index: 1000;
	}
</style>

<script>
	const loop = document.querySelector('.loop');
	
	if(loop){
		loop.addEventListener('click', () => {
			const audio = document.getElementById('piano-audio');
			if(audio) {
				if (audio.paused) {
					loop.textContent = 'no_sound';
					audio.play();
				} else {
					loop.textContent = 'brand_awareness';
					audio.pause();
				}
			}
		});
	}
</script>