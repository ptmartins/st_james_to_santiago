---
import { Image } from "astro:assets";
import logo from "../images/logo.webp";
import Navigation from "../components/Navigation.astro";
---

<header class="header">
    <div class="inner-container header__inner">
        <div class="header__logo">
            <a href="/" title="Home">
                <Image src={logo} alt="Logo" height="60" />
            </a>
        </div>
        <div class="header__nav">
            <Navigation />
            <a href="/#donate" class="btn btn--cta">Contribute</a>
        </div>
    </div>
</header>

<style>
    .header {
        background-color: var(--bg-color);
        border-radius: 12px;
        box-shadow: 0 0 50px 10px rgba(0, 0, 0, 0.9);
        inset-inline-start: 50%;
        padding-block: 0.75rem;
        padding-inline: 1.5rem;
        position: fixed;
        top: 0;
        transform: translateX(-50%);
        transition: var(--default-transition);
        width: 100%;
        z-index: 9999;
    }

    .header.scrolled {
        border-radius: 0;
        top: 0;
        width: 100%;
    }

    .header__inner {
        align-items: center;
        display: flex;
        justify-content: space-between;
    }

    .header__logo,
    .header__logo a {
        align-items: center;
        display: flex;
    }

    .header__nav {
        align-items: center;
        display: flex;

        .btn--cta {
            box-shadow: 0 0 0 0 rgb(248, 162, 1);
            animation: pulse 2s infinite cubic-bezier(0.66, 0, 0, 1);

            &:hover {
                animation: none;
            }
        }
    }

    :global(.is-mobile) {
        .btn--cta {
            order: -1;
            margin-inline-end: 1rem;
        }
    }

    :global(:not(.is-mobile)) {
        .btn--cta {
            margin-inline-start: 2.5rem;
        }
    }

    @keyframes pulse {
        to {
            box-shadow: 0 0 0 10px rgba(248, 162, 1, 0);
        }
    }

    @media all and (min-width: 480px) {
        .header {
            width: 90%;
        }
    }

    @media all and (min-width: 768px) {
        .header {
            padding-inline: 3rem;
        }
    }

    @media all and (min-width: 992px) {
    }

    @media all and (min-width: 1440px) {
        .header {
            padding-inline: 3rem;
            top: 3rem;
            width: calc(var(--inner-container-width) + 6rem);
        }
    }
</style>
