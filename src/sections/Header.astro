---
import { Image } from 'astro:assets';
import logo from '../images/logo.webp';
import Navigation from '../components/Navigation.astro';
---

<header class="header">
    <div class="inner-container header__inner">
        <div class="header__logo">
            <a href="/" title="Home">
                <Image src={ logo } alt="Logo" height="60">
            </a>
        </div>
        <div class="header__nav">
            <Navigation />
            <button class="btn btn--cta">Contribute</button>
        </div>
    </div>
</header>

<style>
    .header {
        background-color: rgba(70, 70, 70, .96);
        border-radius: 22px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, .88);
        inset-inline-start: 50%;
        max-width: var(--inner-container-width);
        padding-block: .75rem;
        padding-inline: 3rem;;
        position: fixed;
        top: 3rem;
        transform: translateX(-50%);
        width: 100%;;
        z-index: 10;
    }

    .header__inner {
        align-items: center;
        display: flex;
        justify-content: space-between;
    }

    .header__logo,
    .header__logo a {
        align-items: center;
        display: flex;
    }

    .header__nav {
        align-items: center;
        display: flex;

        .btn--cta {
            margin-inline-start: 2rem;
        }
    }
</style>