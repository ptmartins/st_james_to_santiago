---
import { Image } from 'astro:assets';
import logo from '../images/logo.webp';
import Navigation from '../components/Navigation.astro';
---

<header class="header">
    <div class="inner-container header__inner">
        <div class="header__logo">
            <a href="/" title="Home">
                <Image src={ logo } alt="Logo" height="60">
            </a>
        </div>
        <div class="header__nav">
            <Navigation />
            <button class="btn btn--cta">Contribute</button>
        </div>
    </div>
</header>

<style>
    .header {
        background-color: var(--black);
        box-shadow: 0 0 50px 10px rgba(0, 0, 0, 0.9);
        inset-inline-start: 50%;
        padding-block: .75rem;
        padding-inline: 3rem;
        position: fixed;
        top: 3rem;
        transform: translateX(-50%);
        transition: var(--default-transition);
        width: calc(var(--inner-container-width) + 6rem);
        z-index: 9999;
    }

    .header.scrolled {
        top: 0;
    }

    .header__inner {
        align-items: center;
        display: flex;
        justify-content: space-between;
    }

    .header__logo,
    .header__logo a {
        align-items: center;
        display: flex; 
    }

    .header__nav {
        align-items: center;
        display: flex;
    }

    :global(.is-mobile) {
        .btn--cta {
            order: -1;
            margin-inline-end: 2.5rem;
        }
    }

    :global(:not(.is-mobile)) {
        .btn--cta {
            margin-inline-start: 2.5rem;
        }
    }

    @meida all and (min-width: 1440px) {
        header {
            width: 100%;
        }
    }
</style>