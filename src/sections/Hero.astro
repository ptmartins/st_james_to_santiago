---
import { gsap } from "gsap";
import overlay from "@/images/fuzz.avif";
---

<section class="section section--hero">
    <!-- Preload hero image for LCP optimization -->
    <link
        rel="preload"
        as="image"
        href="/images/hero.webp"
        imagesrcset="/images/hero.webp 1920w"
        imagesizes="100vw"
    />
    <picture class="hero-bg">
        <source
            srcset="/images/hero.webp 1920w, /images/hero.webp 1280w"
            type="image/webp"
            sizes="100vw"
        />
        <img
            src="/images/hero.webp"
            srcset="/images/hero.webp 1920w, /images/hero.webp 1280w"
            sizes="100vw"
            alt="Hero"
            width="1920"
            height="1080"
            fetchpriority="high"
            decoding="async"
            loading="eager"
            style="aspect-ratio: 16/9; width: 100%; height: 100%; object-fit: cover; object-position: center;"
        />
    </picture>

    <div class="inner-container">
        <h1 id="title" class="hero__title">From St. James to Santiago</h1>
        <h2 id="subTititle" class="hero__subTitle">
            What happens when you turn a personal challenge into a project to
            also give something back?
        </h2>
    </div>
    <div class="overlay" style={`--overlay: url(${overlay.src});`}></div>
    <div class="hero__overlay"></div>
</section>

<style>
    .section--hero {
        margin-block: 0;
        min-height: 100vh;
        padding: 0;
        position: relative;

        .inner-container {
            inset-block-start: 50%;
            inset-inline-start: 50%;
            position: absolute;
            translate: -50% -50%;
            width: 100%;
        }
    }

    .hero-bg {
        display: block;
        filter: brightness(0.5);
        height: 100vh;

        img {
            height: 100%;
            object-fit: cover;
            width: 100%;
        }
    }

    .hero__title {
        font-size: 2.3rem;
        letter-spacing: -1px;
        margin-block-end: 6rem;
        margin-inline: auto;
        text-align: center;
    }

    .hero__subTitle {
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: unset;
        line-height: 1.4;
        margin-block-end: 4.5rem;
        margin-inline: auto;
        text-align: center;
        text-transform: unset;
        width: 90%;
    }

    .hero__overlay {
        background: linear-gradient(
            180deg,
            rgba(10, 10, 10, 0) 40%,
            rgb(24, 24, 24) 98%
        );
        flex: none;
        inset: 0;
        overflow: hidden;
        position: absolute;
        z-index: 200;
    }

    .overlay {
        background-image: var(--overlay);
        background-position: top left;
        background-repeat: repeat;
        background-size: 200px auto;
        filter: brightness(0.5);
        height: 100%;
        inset-inline-start: 0;
        pointer-events: none;
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 100;
    }

    @media all and (min-width: 768px) {
        .hero__title {
            font-size: 3.5rem;
        }
    }

    @media all and (min-width: 992px) {
        .hero__title {
            font-size: 4.8rem;
            letter-spacing: -2px;
        }
    }

    @media all and (min-width: 1440px) {
        .hero__subTitle {
            font-size: 2rem;
            width: 60%;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import SplitType from 'split-type'

    const title = new SplitType('#title', { types: 'words' });
    const subTitle = new SplitType('#subTititle', { types: 'words' });

    const timeline = gsap.timeline({ defaults: { ease: "power2.out" } });
    timeline
        .from(title.words, {
            y: -50,
            opacity: 0,
            stagger: 0.1,
            duration: 1,
        })
        .from(subTitle.words, {
            opacity: 0,
            stagger: 0.1,
            duration: 1,
        }, "-=1");

</script>
