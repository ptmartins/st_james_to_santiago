---
import { gsap } from "gsap";
import { Image } from "astro:assets";
import heroImage from "@/images/hero.webp"; // Move to src/images/
import overlay from "@/images/fuzz.avif";
---

<section class="section section--hero">
    <!-- Preload hero image for LCP optimization -->
    <Image
        class="hero-bg"
        src={heroImage}
        alt="Hero"
        width={1920}
        height={1080}
        quality={80}
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
    />

    <div class="inner-container">
        <h1 id="title" class="hero__title">From St. James to Santiago</h1>
        <h2 id="subTititle" class="hero__subTitle">
            What happens when you turn a personal challenge into a project to
            also give something back?
        </h2>
    </div>
    <div class="overlay" style={`--overlay: url(${overlay.src});`}></div>
    <div class="hero__overlay"></div>
    <div class="scroll-downs">
        <div class="mousey">
            <div class="scroller"></div>
        </div>
    </div>
</section>

<style>
    .section--hero {
        color: var(--white);
        margin-block: 0;
        min-height: 100vh;
        padding: 0;
        position: relative;

        .inner-container {
            inset-block-start: 50%;
            inset-inline-start: 50%;
            margin: 0 auto;
            position: absolute;
            translate: -50% -50%;
            width: 90%;
            z-index: 500;
        }
    }

    .hero-bg {
        display: block;
        filter: brightness(0.5);
        height: 100vh;
        object-fit: cover;
        width: 100%;

        img {
            height: 100%;
            object-fit: cover;
            width: 100%;
        }
    }

    .hero__title {
        font-size: 2.3rem;
        letter-spacing: -1px;
        margin-block-end: 6rem;
        margin-inline: auto;
        text-align: center;
    }

    .hero__subTitle {
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: unset;
        line-height: 1.4;
        margin-block-end: 4.5rem;
        margin-inline: auto;
        opacity: 0.8;
        text-align: center;
        text-transform: unset;
        width: 90%;
    }

    .hero__overlay {
        background: linear-gradient(
            180deg,
            rgba(10, 10, 10, 0) 40%,
            rgb(24, 24, 24) 98%
        );
        flex: none;
        inset: 0;
        overflow: hidden;
        position: absolute;
        z-index: 200;
    }

    .overlay {
        background-image: var(--overlay);
        background-position: top left;
        background-repeat: repeat;
        background-size: 200px auto;
        filter: brightness(0.5);
        height: 100%;
        inset-inline-start: 0;
        pointer-events: none;
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 100;
    }

    .scroll-downs {
        position: absolute;
        bottom: 9rem;
        left: 50%;
        transform: translateX(-50%);
        transition: opacity 0.4s ease-in;

        width: 34px;
        height: 55px;
        z-index: 200;
    }

    .mousey {
        width: 3px;
        padding: 10px 15px;
        height: 35px;
        border: 2px solid #fff;
        border-radius: 25px;
        opacity: 0.75;
        box-sizing: content-box;
    }

    .scroller {
        width: 3px;
        height: 10px;
        border-radius: 25%;
        background-color: #fff;
        animation-name: scroll;
        animation-duration: 2.2s;
        animation-timing-function: cubic-bezier(0.15, 0.41, 0.69, 0.94);
        animation-iteration-count: infinite;
    }

    @keyframes scroll {
        0% {
            opacity: 0;
        }
        10% {
            transform: translateY(0);
            opacity: 1;
        }
        100% {
            transform: translateY(15px);
            opacity: 0;
        }
    }

    @media all and (min-width: 768px) {
        .hero__title {
            font-size: 3.5rem;
        }
    }

    @media all and (min-width: 992px) {
        .hero__title {
            font-size: 4.8rem;
            letter-spacing: -2px;
        }
    }

    @media all and (min-width: 1440px) {
        .section--hero {
            .inner-container {
                margin: 0;
            }
        }

        .hero__subTitle {
            font-size: 2rem;
            width: 60%;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import SplitType from "split-type";

    const title = new SplitType("#title", { types: "words" });
    const subTitle = new SplitType("#subTititle", { types: "words" });

    const timeline = gsap.timeline({ defaults: { ease: "power2.out" } });
    timeline
        .from(title.words, {
            y: -50,
            opacity: 0,
            stagger: 0.1,
            duration: 1,
        })
        .from(
            subTitle.words,
            {
                opacity: 0,
                stagger: 0.1,
                duration: 1,
            },
            "-=1",
        );
</script>
