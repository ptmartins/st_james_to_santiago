---
import heroBg from '../images/hero.jpg';
---

<section class="section section--hero">
    <div class="hero-bg" style={`--hero-bg: url(${heroBg.src});`}></div>
    <div class="inner-container">
        <h1 class="hero__title">From St. James to Santiago</h1>
        <h3 class="hero__subTitle">What happens when you turn a personal challenge into a project to also give something back?</h3>
    </div>
    <div class="hero__overlay"></div>
</section>

<style>
    .section--hero {
        margin-block: 0;
        min-height: 100vh;

        .inner-container {
            inset-block-start: 50%;
            inset-inline-start: 50%;
            position: absolute;
            translate: -50% -50%;
            width: 100%;
        }
    }

    .hero-bg {
        background-image: var(--hero-bg);
        background-size: cover;
        background-position: bottom 3rem;
        filter: brightness(0.5);
        height: 100vh;
        inset-block: 0 0;
        inset-inline: 0 0;
        position: absolute;
    }

    .hero__title {
        font-size: 4.5rem;
        letter-spacing: -2px;
        margin-block-end: 6rem;
        margin-inline: auto;
        text-align: center;
    }

    .hero__subTitle {
        font-weight: 400;
        letter-spacing: unset;
        margin-block-end: 4.5rem;
        margin-inline: auto;
        text-align: center;
        text-transform: unset;
        width: 60%;
    }

    .hero__overlay {
        background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgb(0, 0, 0) 99%);
        flex: none;
        inset: 0;
        overflow: hidden;
        position: absolute;
    }
    
</style>