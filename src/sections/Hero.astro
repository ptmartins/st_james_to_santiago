---

---

<section class="section section--hero">
    <!-- Preload hero image for LCP optimization -->
    <link rel="preload" as="image" href="/images/hero.webp" imagesrcset="/images/hero.webp 1920w, /images/hero.jpg 1280w" imagesizes="100vw" />
    <picture class="hero-bg">
        <source srcset="/images/hero.webp 1920w, /images/hero.webp 1280w" type="image/webp" sizes="100vw" />
        <img
            src="/images/hero.webp"
            srcset="/images/hero.webp 1920w, /images/hero.webp 1280w"
            sizes="100vw"
            alt="Hero"
            width="1920" height="1080"
            fetchpriority="high"
            decoding="async"
            loading="eager"
            style="aspect-ratio: 16/9; width: 100%; height: 100%; object-fit: cover; object-position: center;"
        />
    </picture>

    <div class="inner-container">
    <h1 class="hero__title">From St. James to Santiago</h1>
    <h2 class="hero__subTitle">What happens when you turn a personal challenge into a project to also give something back?</h2>
    </div>
    <div class="hero__overlay"></div>
</section>

<style>
    .section--hero {
        margin-block: 0;
        min-height: 100vh;
        padding: 0;

        .inner-container {
            inset-block-start: 50%;
            inset-inline-start: 50%;
            position: absolute;
            translate: -50% -50%;
            width: 100%;
        }
    }

    .hero-bg {
        display: block;
        filter: brightness(0.5);
        height: 100vh;

        img {
            height: 100%;
            object-fit: cover;
            width: 100%;
        }
    }

    .hero__title {
        font-size: 3.2rem;
        letter-spacing: -2px;
        margin-block-end: 6rem;
        margin-inline: auto;
        text-align: center;
    }

    .hero__subTitle {
        font-weight: 400;
        letter-spacing: unset;
        margin-block-end: 4.5rem;
        margin-inline: auto;
        text-align: center;
        text-transform: unset;
        width: 60%;
    }

    .hero__overlay {
        background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgb(0, 0, 0) 99%);
        flex: none;
        inset: 0;
        overflow: hidden;
        position: absolute;
    }

    @media all and (min-width: 768px) {

    }

    @media all and (min-width: 992px) {
        .hero__title {
            font-size: 4.8rem;
        }
    }

    @media all and (min-width: 1440px) {
    
    }
    
</style>