---
import crUK from "../images/logos/cr_uk_logo.png";
import act from "../images/logos/act_logo.webp";
import { Image } from "astro:assets";
import "../styles/beneficiaries.css";
---

<section class="section section--beneficiaries">
    <div class="inner-container">
        <h2 class="section__title">Beneficiaries</h2>
        <div class="beneficiaries">
            <a
                href="https://www.cancerresearchuk.org/"
                target="_blank"
                rel="noopener"
                class="beneficiary"
            >
                <Image
                    src={crUK}
                    alt="Cancer Research UK"
                    class="beneficiary__logo"
                />
            </a>
            <a
                href="https://act4addenbrookes.org.uk/"
                target="_blank"
                rel="noopener"
                class="beneficiary"
            >
                <Image
                    src={act}
                    alt="Addenbrooke's Charitable Trust"
                    class="beneficiary__logo"
                />
            </a>
        </div>
    </div>
</section>

<style>
    .section--beneficiaries {
        position: relative;
    }

    .beneficiary {
        align-items: center;
        background-color: var(--bg-color);
        border: 1px solid #222;
        border-radius: var(--border-radius);
        box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.98);
        display: flex;
        padding: 0.75rem;
        place-self: normal;
        transition: var(--default-transition);

        &:hover {
            box-shadow: 0 0 2px 0 rgba(0, 0, 0, 0.98);
        }
    }
</style>
