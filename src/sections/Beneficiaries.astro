---
import  crUK from '../images/logos/cr_uk_logo.png';
import act from '../images/logos/act_logo.webp';
import { Image } from 'astro:assets';
---

<section class="section section--beneficiaries">
    <div class="inner-container">
        <h2 class="section__title">Beneficiaries</h2>
        <div class="beneficiaries">
            <a href="https://www.cancerresearchuk.org/" target="_blank" rel="noopener">
                <Image src={crUK} alt="Cancer Research UK" class="beneficiary__logo" />
            </a>
            <a href="https://act4addenbrookes.org.uk/" target="_blank" rel="noopener">
                <Image src={act} alt="Addenbrooke's Charitable Trust" class="beneficiary__logo" />
            </a>
        </div>
    </div>
</section>

<style>
    .section--beneficiaries {
        height: auto;
    }

    .beneficiaries {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 6rem;

        a {
            text-align: center;
        }
        img {
            filter: grayscale(100%) brightness(100);
            height: auto;
            object-fit: cover;
            transition: var(--default-transition);
            width: 70%;

            &:hover {
                filter: none;
            }
        }
    }

    @media all and (min-width: 768px) {
    }

    @media all and (min-width: 992px) {
        .beneficiaries {
            
            img {]
                width: 85%;
            }
        }
    }

    @media all and (min-width: 1440px) {
        .beneficiaries {
            img {
                width: 100%;
            }
        }
    }
</style>