---
import LeafletMap from "../components/LeafletMap.jsx";
import Stop from "../components/Stop.astro";
import { route } from "../data/data.js";
---

<section class="section section--itinerary">
    <div class="inner-container">
        <h2 class="section__title">Itinerary</h2>
        <div class="routes">
            {route.map((item) => <Stop data={item} />)}
        </div>
        <div class="route__map">
            <LeafletMap client:only="react" />
        </div>
    </div>
</section>

<style>
    .routes {
        margin-block-end: 9rem;
    }

    .stop {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
    }

    .stop__ferry {
        font-size: 3.4rem;
    }
</style>
