---
import Stat from '../components/Stat.astro';
---

<section class="section section--stats">
    <div class="inner-container">
        <h2 class="section__title">The project in numbers <span class="title__estimated">(estimated)</span></h2>
        <div class="stats">
            <Stat title="Total distance" icon="route" value="686 km" />
            <Stat title="Days" icon="calendar_clock" value="15 days" />
            <Stat title="Average speed" icon="speed" value="18 km/h" />
            <Stat title="Energy needed" icon="energy" value="~38,000 kcal" />
            <Stat title="Total altitude gain" icon="altitude" value="~13,300 m" />
            <Stat title="Highest point" icon="highest" value="720 m" />
        </div>
    </div>
</section>

<style>
    .section--stats {
        align-items: center;
        display: flex;
        min-height: unset;

        .inner-container {
            width: 100%;
        }
    }

    .stats {
        display: grid;
        gap: 3rem;   
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        justify-items: center;
    }   

    .stats > * {
        justify-self: start;
    }

    .title__estimated {
        font-size: 1.2rem;
        font-weight: 400;
        letter-spacing: normal;
        margin-left: 0.5rem;
        text-transform: initial;
        opacity: .65;
    }
</style>