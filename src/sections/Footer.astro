---
import { Image } from "astro:assets";
import logo from "../images/logo.webp";
const date = new Date();
const year = date.getFullYear();
---

<footer class="footer">
    <div class="inner-container footer__inner">
        <p class="footer__copy">
            <Image src={logo} alt="Logo" class="footer__logo" /> From St. James to
            Santiago, © {year}
        </p>
        <p class="footer__attrib">
            A project by <a href="https://pedromartins.com.pt" target="_blank"
                >Pedro Martins</a
            >
        </p>
    </div>
</footer>

<style>
    .footer {
        font-size: 1.2rem;
        font-weight: 400;
        padding-inline: 1.5rem;
        padding-block-end: 1.5rem;

        .inner-container {
            align-items: center;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            justify-content: space-between;
            padding-block-start: 3rem;
        }

        p {
            margin-block-end: 0;
        }
    }

    .footer__copy {
        align-items: center;
        display: flex;
        gap: 0.75rem;
    }

    .footer__logo {
        height: 30px;
        object-fit: cover;
        width: 30px;
    }

    @media all and (min-width: 992px) {
        .footer {
            padding-block-end: 4.5rem;
            .inner-container {
                flex-direction: row;
                gap: unset;
            }
        }
    }

    @media all and (min-width: 1440px) {
        .footer {
            padding-inline: 0;
        }
    }
</style>
