---
import { Image } from 'astro:assets';
import logo from '../images/logo.webp';
const date = new Date();
const year = date.getFullYear();
---


<footer class="footer">
    <div class="inner-container footer__inner">
        <p class="footer__copy"> <Image src={ logo } alt="Logo" class="footer__logo" /> From St. James to Santiago, © {year}</p>
        <p class="footer__attrib">Developed by <a href="https://pedromartins.com.pt" target="_blank">Pedro Martins</a> and built with <a href="https://astro.build/" target="_blank">Astro.js</a></p>
    </div>
</footer>

<style>
    .footer {
        background: linear-gradient(180deg, rgb(62, 62, 62) 0%, rgb(0, 0, 0) 100%);
        font-size: 1.1rem;
        padding-block-end: 4.5rem;

        .inner-container{
            border-block-start: 1px solid var(--white);
            display: flex;
            justify-content: space-between;
            padding-block-start: 3rem;
        }

        p {
            margin-block-end: 0;
        }
    }

    .footer__copy {
        align-items: center;
        display: flex;
        gap: .75rem;
    }

    .footer__logo {
        height: 30px;
        object-fit: cover;
        width: 30px;;
    }
</style>