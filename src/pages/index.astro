---
import Layout from '../layouts/Layout.astro';
import Beneficiaries from '../sections/Beneficiaries.astro';
import Hero from '../sections/Hero.astro';
import Intro from '../sections/Intro.astro';
import Stats from '../sections/Stats.astro'; 
import Route from '../sections/Route.astro';
import overlay from '../images/fuzz.avif';
---

<Layout>
	<Hero />
	<Intro />
	<Stats />
	<Beneficiaries />
	<Route />
	<div class="overlay" style={`--overlay: url(${overlay.src});`}></div>
</Layout>

<style>
	.overlay {
		background-image: var(--overlay);
		background-position: top left;
		background-repeat: repeat;
		background-size: 90px auto;
		filter: brightness(0.65);
		height: 100%;
		inset-inline-start: 0;
		pointer-events: none;
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 9999;
	}
</style>