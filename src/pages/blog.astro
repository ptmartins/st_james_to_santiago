---
import Layout from "../layouts/Layout.astro";
import Subscription from "../components/Subscription.astro";
import { isRenderTemplateResult } from "astro/dist/runtime/server/render/astro";
import "../styles/blog.css";

// Contentful client setup
const CONTENTFUL_SPACE_ID = import.meta.env.CONTENTFUL_SPACE_ID;
const CONTENTFUL_ACCESS_TOKEN = import.meta.env.CONTENTFUL_ACCESS_TOKEN;

// Fetch blog posts from Contentful
const response = await fetch(`https://cdn.contentful.com/spaces/${CONTENTFUL_SPACE_ID}/entries?content_type=blogPost&access_token=${CONTENTFUL_ACCESS_TOKEN}`);
const data = await response.json();


const assets = {};
if (data.includes?.Asset) {
    data.includes.Asset.forEach(asset => {
        assets[asset.sys.id] = asset;
    });
}


// Process the posts data
const posts = data.items.map(item => {

    let mediaUrl = '';
    if (item.fields.media?.sys?.id) {
        const asset = assets[item.fields.media.sys.id];
        if (asset?.fields?.file?.url) {
            mediaUrl = `https:${asset.fields.file.url}`;
        }
    }

    return {
    id: item.sys.id,
    title: item.fields.title,
    slug: item.fields.slug,
    excerpt: item.fields.excerpt,
    content: item.fields.post.content[0].content[0].value,
    publishedDate: item.fields.date,
    media: mediaUrl
    }
});
---

<Layout title="Blog">
    <section class="section section--blog">
        <div class="inner-container">
            <h1 class="section__title">Blog        <button id="subscribe">subscribe</button>    <!--  <Subscription /> --> </h1>

            
            <div class="blog-posts">
                {posts.map(post => (
                    <article class="blog-post">
                        {post.media && (
                            <img 
                                src={post.media} 
                                alt={post.title}
                                class="blog-post__image"
                            />
                        )}
                        <div class="blog-post__content">
                            <h2 class="blog-post__title">
                                <a href={`/blog/${post.slug}`}>{post.title}</a>
                            </h2>
                            {post.excerpt && (
                                <p class="blog-post__excerpt">{post.excerpt}</p>
                            )}
                            <time class="blog-post__date">
                                {new Date(post.publishedDate).toLocaleDateString()}
                            </time>
                            <div class="">
                                {post.content}
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>
</Layout>


