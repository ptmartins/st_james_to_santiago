---
import Layout from '../layouts/Layout.astro';
import ActivityList from '../components/ActivityList.astro';
import DashboardItem from '../components/DashboardItem.astro';

let activities = [];
let totalSessions = 0;
let totalDistance = 0;
let totalDuration = 0;
let totalDurationFormatted;
let speed = 0;
let avgSpeed = 0;

const apiUrl =
  import.meta.env.PUBLIC_SITE_URL
    ? `${import.meta.env.PUBLIC_SITE_URL}/api/strava`
    : '/api/strava';

try {
  const res = await fetch(apiUrl);
  activities = await res.json();
  console.log(activities);


  activities.forEach(activity => {
    totalSessions++;
    totalDistance = totalDistance + parseFloat((activity.distance / 1000).toFixed(1));
    totalDuration = totalDuration + activity.elapsed_time;
    totalDurationFormatted = new Date(totalDuration* 1000).toISOString().substr(11, 8);
    speed = speed + activity.average_speed;
  });

} catch (err) {
  console.log('Strava fetch error:', err);
  activities = [];
}

  avgSpeed = parseFloat((speed / totalSessions).toFixed(1));
---

<Layout title="Training">
    <section class="section section--training">
        <div class="inner-container">
            <h1 class="section__title">Training</h1>

                <!-- Dashboard -->
                <div class="training__dashboard">
                  <DashboardItem type="sessions" data={ totalSessions } />
                  <DashboardItem type="distance" data={ totalDistance } />
                  <DashboardItem type="duration" data={ totalDurationFormatted } />
                  <DashboardItem type="speed" data={ avgSpeed } />
                </div>

                <!-- Sessions -->
                <div class="training__sessions">
                  <h2>Sessions</h2>
                  { activities.length > 0 ? (
                      <ActivityList activities={ activities } />
                      ) : (
                      <p>No activities found.</p>
                  )}
                </div>
        </div>
    </section>
</Layout>

<style>

  h2 {
    margin-block-end: 3rem;
  }
  .section--training {
    background: linear-gradient(180deg, rgb(0, 0, 0) 0%, rgb(62, 62, 62) 100%);
    height: 100%;
    margin-block-end: 0;
    min-height: 100vh;
    padding-block-end: 9rem;
  }

  .training__dashboard {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    margin-block-end: 9rem;
  }

  .training__dashboard > * {
    flex: 1 0 25%;
  }
</style>