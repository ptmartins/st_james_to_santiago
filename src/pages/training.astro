---
import Layout from "../layouts/Layout.astro";
import ActivityList from "../components/ActivityList.astro";
import DashboardItem from "../components/DashboardItem.astro";
import TrainingChart from "../components/TrainingChart.astro";
import { getStravaActivities } from "../lib/strava";
import "../styles/training.css";

let activities: any[] = [];
let totalSessions = 0;
let totalDistance = 0;
let totalDuration = 0;
let totalDurationFormatted = "00:00:00";
let speed = 0;
let avgSpeed = 0;

try {
    console.log("Fetching Strava activities...");
    activities = await getStravaActivities();
    console.log("Activities received:", activities.length);

    activities.forEach((activity: any) => {
        totalSessions++;
        totalDistance =
            totalDistance + parseFloat((activity.distance / 1000).toFixed(1));
        totalDuration = totalDuration + activity.elapsed_time;
        totalDurationFormatted = new Date(totalDuration * 1000)
            .toISOString()
            .substr(11, 8);
        speed = speed + activity.average_speed;
    });

    console.log("Total sessions:", totalSessions);
    console.log("Total distance:", totalDistance);
} catch (err) {
    console.error("Strava fetch error:", err);
    activities = [];
}

avgSpeed =
    totalSessions > 0 ? parseFloat((speed / totalSessions).toFixed(1)) : 0;
---

<Layout title="Training">
    <section class="section section--training">
        <div class="inner-container">
            <h1 class="section__title">Training</h1>

            <!-- Dashboard -->
            <div class="training__dashboard">
                <!-- <div class="dashboardStats"> -->
                <DashboardItem type="sessions" data={totalSessions} />
                <DashboardItem type="distance" data={totalDistance} />
                <DashboardItem type="duration" data={totalDurationFormatted} />
                <DashboardItem type="speed" data={avgSpeed} />
                <!-- </div> -->
            </div>

            <!-- Sessions -->
            <div class="training__sessions">
                <h2>Sessions</h2>
                <div class="sessions__header">
                    <span class="header__type">Type</span>
                    <span class="header__date">Date/Time</span>
                    <span class="header__duration">Duration</span>
                    <span class="header__distance">Dist. (km)</span>
                    <span class="header__avgSpeed">Avg. speed</span>
                    <span class="header__altGain">Alt. gain</span>
                    <span class="header__calories">Calories</span>
                </div>
                {
                    activities.length > 0 ? (
                        <ActivityList activities={activities} />
                    ) : (
                        <p>No activities found.</p>
                    )
                }
            </div>
        </div>
    </section>
</Layout>
