---
import Layout from '../layouts/Layout.astro';
import SessionList from '../components/SessionList.astro';

let activities = [];
try {
  const res = await fetch('http://localhost:4321/api/strava');
  activities = await res.json();
  console.log(activities);
} catch (e) {
  activities = [];
}
---

<Layout title="Training">
    <section class="section section--training">
        <div class="inner-container">
            <h1 class="section__title">Training</h1>
                { activities.length > 0 ? (
                    <SessionList activities={ activities } />
                    ) : (
                    <p>No activities found.</p>
                )}
        </div>
    </section>
</Layout>

<style>
  .section--training {
      background: linear-gradient(180deg, rgb(0, 0, 0) 0%, rgb(62, 62, 62) 100%);
      margin-block-end: 0;
      min-height: 100vh;
      padding-block-end: 9rem
    }
</style>