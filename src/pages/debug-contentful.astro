---
// Debug page to see Contentful data structure
const CONTENTFUL_SPACE_ID = import.meta.env.CONTENTFUL_SPACE_ID;
const CONTENTFUL_ACCESS_TOKEN = import.meta.env.CONTENTFUL_ACCESS_TOKEN;

let data = null;
let error = null;

try {
  const response = await fetch(`https://cdn.contentful.com/spaces/${CONTENTFUL_SPACE_ID}/entries?content_type=blogPost&access_token=${CONTENTFUL_ACCESS_TOKEN}`);
  data = await response.json();
} catch (e) {
  error = e.message;
}
---

<html>
<head>
  <title>Debug Contentful</title>
  <style>
    body { font-family: monospace; padding: 20px; }
    pre { background: #f5f5f5; padding: 15px; overflow: auto; }
    .error { color: red; }
  </style>
</head>
<body>
  <h1>Contentful Debug Data</h1>
  
  {error && (
    <div class="error">
      <h2>Error:</h2>
      <p>{error}</p>
    </div>
  )}
  
  {data && (
    <div>
      <h2>Raw Contentful Response:</h2>
      <pre>{JSON.stringify(data, null, 2)}</pre>
    </div>
  )}
</body>
</html>