---
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog.css';

// Server-side rendering for dynamic routes
export const prerender = false;

// Contentful client setup  
const CONTENTFUL_SPACE_ID = import.meta.env.CONTENTFUL_SPACE_ID;
const CONTENTFUL_ACCESS_TOKEN = import.meta.env.CONTENTFUL_ACCESS_TOKEN;

// Get the slug from the URL params
const { slug } = Astro.params;

// Fetch the specific post data
let post: any = null;
let error: string | null = null;

try {
  if (!CONTENTFUL_SPACE_ID || !CONTENTFUL_ACCESS_TOKEN) {
    throw new Error('Contentful environment variables are not configured');
  }
  
  // Fetch all posts and find the one with matching slug
  const response = await fetch(`https://cdn.contentful.com/spaces/${CONTENTFUL_SPACE_ID}/entries?content_type=blogPost&access_token=${CONTENTFUL_ACCESS_TOKEN}`);
  const data = await response.json();

  const assets: any = {};
  if (data.includes?.Asset) {
    data.includes.Asset.forEach((asset: any) => {
      assets[asset.sys.id] = asset;
    });
  }

  // Find the post with matching slug
  const foundItem = data.items.find((item: any) => item.fields.slug === slug);
  
  if (foundItem) {
    let mediaUrl = '';
    if (foundItem.fields.media?.sys?.id) {
      const asset = assets[foundItem.fields.media.sys.id];
      if (asset?.fields?.file?.url) {
        mediaUrl = `https:${asset.fields.file.url}`;
      }
    }

    post = {
      id: foundItem.sys.id,
      title: foundItem.fields.title,
      slug: foundItem.fields.slug,
      excerpt: foundItem.fields.excerpt,
      content: foundItem.fields.post,
      publishedDate: foundItem.fields.date,
      media: mediaUrl
    };
  } else {
    error = `Post with slug "${slug}" not found`;
  }
} catch (e) {
  error = `Error fetching post: ${(e as Error).message}`;
}

// Debug logging (can be removed in production)
console.log('Accessing blog post:', slug, post ? '✓' : '✗');

// Function to render rich text content from Contentful
function renderRichText(content: any): string {
  // Handle different content structures
  if (!content) return '';
  
  // If content is already a string (fallback from the blog index processing)
  if (typeof content === 'string') {
    return `<p>${content}</p>`;
  }
  
  // If content is the rich text document structure
  if (!content.content || !Array.isArray(content.content)) {
    console.warn('Invalid content structure:', content);
    return '';
  }
  
  return content.content.map((node: any) => {
    if (!node || !node.nodeType) return '';
    
    switch (node.nodeType) {
      case 'paragraph':
        const paragraphText = node.content?.map((textNode: any) => textNode.value || '').join('') || '';
        return `<p>${paragraphText}</p>`;
      case 'heading-1':
        const h1Text = node.content?.map((textNode: any) => textNode.value || '').join('') || '';
        return `<h1>${h1Text}</h1>`;
      case 'heading-2':
        const h2Text = node.content?.map((textNode: any) => textNode.value || '').join('') || '';
        return `<h2>${h2Text}</h2>`;
      case 'heading-3':
        const h3Text = node.content?.map((textNode: any) => textNode.value || '').join('') || '';
        return `<h3>${h3Text}</h3>`;
      case 'unordered-list':
        const listItems = node.content?.map((listItem: any) => {
          const itemText = listItem.content?.[0]?.content?.map((textNode: any) => textNode.value || '').join('') || '';
          return `<li>${itemText}</li>`;
        }).join('') || '';
        return `<ul>${listItems}</ul>`;
      case 'ordered-list':
        const orderedItems = node.content?.map((listItem: any) => {
          const itemText = listItem.content?.[0]?.content?.map((textNode: any) => textNode.value || '').join('') || '';
          return `<li>${itemText}</li>`;
        }).join('') || '';
        return `<ol>${orderedItems}</ol>`;
      default:
        console.warn('Unknown node type:', node.nodeType);
        return '';
    }
  }).join('');
}

let renderedContent = '';
if (post?.content) {
  renderedContent = renderRichText(post.content);
}

// If no content was rendered and we have a post, try to show something
if (!renderedContent && post) {
  renderedContent = '<p>Content is being processed...</p>';
}
---

{error && (
  <Layout title="Error">
    <section class="section section--blog-post">
      <div class="inner-container">
        <h1>Error Loading Post</h1>
        <p>{error}</p>
        <a href="/blog">← Back to Blog</a>
      </div>
    </section>
  </Layout>
)}

{post && (
  <Layout title={post.title}>
  <section class="section section--blog-post">
    <div class="inner-container">
      <article class="blog-post-full">
        <header class="blog-post-full__header">
          <nav class="breadcrumb">
            <a href="/blog">← Back to Blog</a>
          </nav>
          
          <h1 class="blog-post-full__title">{post.title}</h1>
          
          <div class="blog-post-full__meta">
            <time class="blog-post-full__date" datetime={post.publishedDate}>
              {new Date(post.publishedDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>

          {post.excerpt && (
            <p class="blog-post-full__excerpt">{post.excerpt}</p>
          )}
        </header>

        {post.media && (
          <div class="blog-post-full__image">
            <img 
              src={post.media} 
              alt={post.title}
              loading="lazy"
            />
          </div>
        )}

        <div class="blog-post-full__content" set:html={renderedContent || '<p>Content could not be loaded.</p>'}></div>
      </article>
    </div>
  </section>
  </Layout>
)}

