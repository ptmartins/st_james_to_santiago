---
import { Ship } from 'lucide-static';

const { data } = Astro.props;
---

<div class="stop">
    <div class="stop__label"> {data.label} </div>
    <div class="stop__content">

        {
            data.name !== 'Ferry' ?
                <h3> {data.name} </h3>
                <p>Distance cycled: {data.distance} km </p> :
                <span class="ferry"><Fragment set:html={Ship} /></span>
        }


    </div>
</div>

<style>
    .stop {
        display: flex;
        gap: 2rem;
        min-height: 110px;
        opacity: 0;
        position: relative;
        transform: translateY(40px);
        transition: opacity 0.6s cubic-bezier(.4,0,.2,1), transform 0.6s cubic-bezier(.4,0,.2,1);

        &::before {
            background-color: var(--accent);
            border: 3px solid var(--accent);
            border-radius: 50%;
            content: '';
            height: 20px;
            inset-block-start: 10px;
            inset-inline-start: calc(100px - 10px);
            position: absolute;
            width: 20px;
            z-index: 10;
        }

        &::after {
            background-color: rgba(255, 255, 255, .15);
            content: '';
            height: calc(100% - 18px);
            inset-block-start: 28px;
            inset-inline-start: calc(100px + 1.5px);
            position: absolute;
            width: 3px;
        }

        &:last-of-type {
            &::after {
                display: none;
            }
        }
    }

    .stop--visible {
        opacity: 1;
        transform: none;
    }

    .stop__label {
        flex-shrink: 0;
        font-size: 1.3rem;
        font-weight: 600;
        margin-block-start: .375rem;
        position: relative;
        text-transform: uppercase;
        width: 110px;
    }

    .stop__content {

        h3 {
            font-size: 1.8rem;
            margin-block-end: .75rem;
        }

        p {
            font-size: 1.1rem;
            opacity: .85;
        }
    }

    .ferry {
        height: 48px;
        inset-block-start: 0;
        position: absolute;
        width: 48px;
    }

    :global(.lucide.lucide-ship) {
        width: 48px !important;
        height: 48px !important;
        display: inline-block;
        margin-block-end: 3rem;
    }

</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const stopEl = document.querySelectorAll('.stop');
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('stop--visible');
                    }
                });
            },
            { threshold: 0.1 }
        );
        stopEl.forEach(el => observer.observe(el));
    });
</script>