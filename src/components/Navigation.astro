---
const { pathname } = Astro.url;
---

<nav class="nav">
    <a href="/" class={ pathname === '/' ? 'nav__link nav__link--active' : 'nav__link'}>Home</a>
    <a href="/training" class={pathname === '/training' ? 'nav__link nav__link--active' : 'nav__link'}>Training</a>
    <a href="/training" class={pathname === '/progress' ? 'nav__link nav__link--active' : 'nav__link'}>Progress</a>
    <a href="/blog" class={pathname === '/blog' ? 'nav__link nav__link--active' : 'nav__link'}>Blog</a>
</nav>



<style>
    .nav__link {
        color: var(--white);
        font-size: 1.3rem;
        margin-inline-start: 1.5rem;
        position: relative;
        transition: var(--default-transition);

        &:first-child {
            margin-inline-start: 0;
        }

        &:hover {
            color: var(--accent);
        }

        &::after {
            background-color: var(--accent);
            content: '';
            height: 4px;
            inset-block-end: -6px;
            inset-inline-start: 0;
            opacity: 0;
            position: absolute;
            width: 100%;
        }
    }

    .nav__link--active {
        color: var(--accent);

        &::after {
            opacity: 1;
        }
    }
</style>