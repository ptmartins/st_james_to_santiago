---
import { Menu } from "lucide-static";

const { pathname } = Astro.url;
---

<nav class="nav">
    <a
        href="/"
        class={pathname === "/" ? "nav__link nav__link--active" : "nav__link"}
        >Home</a
    >
    <a
        href="/training"
        class={pathname === "/training"
            ? "nav__link nav__link--active"
            : "nav__link"}>Training</a
    >
    <a
        href="/blog"
        class={pathname === "/blog"
            ? "nav__link nav__link--active"
            : "nav__link"}>Blog</a
    >
</nav>
<div class="nav__mobile">
    <button id="navToggle" class="nav__toggle" aria-label="Toggle navigation">
        <Fragment set:html={Menu} />
    </button>
    <ul id="mobileMenu" class="mobile__menu">
        <li>
            <a
                href="/"
                class={pathname === "/"
                    ? "nav__link nav__link--active"
                    : "nav__link"}>Home</a
            >
        </li>
        <li>
            <a
                href="/training"
                class={pathname === "/training"
                    ? "nav__link nav__link--active"
                    : "nav__link"}>Training</a
            >
        </li>
        <li>
            <a
                href="/blog"
                class={pathname === "/blog"
                    ? "nav__link nav__link--active"
                    : "nav__link"}>Blog</a
            >
        </li>
    </ul>

    <style>
        .nav__link {
            color: var(--white);
            font-size: 1.3rem;
            margin-inline-start: 1.5rem;
            position: relative;
            text-decoration: none;
            transition: var(--default-transition);

            &:first-child {
                margin-inline-start: 0;
            }

            &:hover {
                color: var(--accent);
                text-decoration: none;
            }

            &::after {
                background-color: var(--accent);
                content: "";
                height: 4px;
                inset-block-end: -6px;
                inset-inline-start: 0;
                opacity: 0;
                position: absolute;
                width: 100%;
            }
        }

        .nav__link--active {
            color: var(--accent);

            &::after {
                opacity: 1;
            }
        }

        .nav__toggle {
            display: grid;
            height: 48px;
            padding: 0;
            place-items: center;
            width: 48px;
        }

        .nav__toggle svg {
            width: 24px;
            height: 24px;
            display: inline-block;
        }

        .is-mobile .nav {
            display: none;
        }

        :global(.nav__mobile) {
            display: none;

            .mobile__menu {
                display: none;
            }
        }
        :global(.is-mobile) {
            .nav {
                display: none;
            }

            .mobile__menu {
                background-color: var(--bg-color);
                border-radius: 12px;
                inset-block-start: 6rem;
                inset-inline-end: 0;
                padding: 0.75rem;
                position: absolute;
            }

            .mobile__menu.active,
            .nav__mobile {
                display: block;
            }
        }
    </style>
</div>

<script is:inline>
    const navToggle = document.getElementById("navToggle");
    const mobileMenu = document.getElementById("mobileMenu");

    let toggleMobileMenu = () => {
        mobileMenu.classList.toggle("active");
    };

    if (navToggle) {
        navToggle.addEventListener("click", toggleMobileMenu);
    }
</script>
