---
import { Menu, X } from "lucide-static";

const { pathname } = Astro.url;
---

<nav class="nav">
    <a
        href="/"
        class={pathname === "/" ? "nav__link nav__link--active" : "nav__link"}
        >Home</a
    >
    <a
        href="/training"
        class={pathname === "/training"
            ? "nav__link nav__link--active"
            : "nav__link"}>Training</a
    >
    <a
        href="/blog"
        class={pathname === "/blog"
            ? "nav__link nav__link--active"
            : "nav__link"}>Blog</a
    >
</nav>
<div class="nav__mobile">
    <button id="navToggle" class="nav__toggle" aria-label="Toggle navigation">
        <span class="nav__toggle-icon nav__toggle-icon--burger">
            <Fragment set:html={Menu} />
        </span>
        <span class="nav__toggle-icon nav__toggle-icon--close">
            <Fragment set:html={X} />
        </span>
    </button>
    <ul id="mobileMenu" class="mobile__menu">
        <li>
            <a
                href="/"
                class={pathname === "/"
                    ? "nav__link nav__link--active"
                    : "nav__link"}>Home</a
            >
        </li>
        <li>
            <a
                href="/training"
                class={pathname === "/training"
                    ? "nav__link nav__link--active"
                    : "nav__link"}>Training</a
            >
        </li>
        <li>
            <a
                href="/blog"
                class={pathname === "/blog"
                    ? "nav__link nav__link--active"
                    : "nav__link"}>Blog</a
            >
        </li>
    </ul>

    <style>
        .nav__link {
            color: var(--white);
            font-size: 1.3rem;
            margin-inline-start: 1.5rem;
            position: relative;
            text-decoration: none;
            transition: var(--default-transition);

            &:first-child {
                margin-inline-start: 0;
            }

            &:hover {
                color: var(--accent);
                text-decoration: none;
            }

            &::after {
                background-color: var(--accent);
                content: "";
                height: 4px;
                inset-block-end: -6px;
                inset-inline-start: 0;
                opacity: 0;
                position: absolute;
                width: 100%;
            }
        }

        .nav__link--active {
            color: var(--accent);

            &::after {
                opacity: 1;
            }
        }

        .nav__toggle {
            background: transparent;
            border: none;
            cursor: pointer;
            display: grid;
            height: 48px;
            padding: 0;
            place-items: center;
            position: relative;
            width: 48px;
            z-index: 1001;
        }

        .nav__toggle-icon {
            display: grid;
            place-items: center;
            position: absolute;
            transition:
                opacity 0.3s ease,
                transform 0.3s ease;
        }

        .nav__toggle-icon svg {
            width: 24px;
            height: 24px;
            display: inline-block;
            stroke: var(--white);
        }

        .nav__toggle-icon--burger {
            color: var(--white);
            opacity: 1;
            transform: rotate(0deg);
        }

        .nav__toggle-icon--close {
            color: var(--white);
            opacity: 0;
            transform: rotate(-90deg);
        }

        .nav__toggle.active .nav__toggle-icon--burger {
            opacity: 0;
            transform: rotate(90deg);
        }

        .nav__toggle.active .nav__toggle-icon--close {
            opacity: 1;
            transform: rotate(0deg);
        }

        .is-mobile .nav {
            display: none;
        }

        :global(.nav__mobile) {
            display: none;

            .mobile__menu {
                display: none;
            }
        }

        :global(.is-mobile) {
            .nav {
                display: none;
            }

            .mobile__menu {
                background-color: var(--bg-color);
                box-shadow: -4px 0 16px rgba(0, 0, 0, 0.3);
                display: flex;
                flex-direction: column;
                gap: 1rem;
                height: 100vh;
                inset-block-start: 0;
                inset-inline-end: 0;
                list-style: none;
                margin: 0;
                padding: 5rem 2rem 2rem;
                position: fixed;
                transform: translateX(100%);
                transition: transform 0.3s ease-in-out;
                width: 75vw;
                z-index: 1000;
            }

            .mobile__menu.active {
                transform: translateX(0);
            }

            .mobile__menu li {
                margin: 0;
            }

            .mobile__menu .nav__link {
                font-size: 1.5rem;
                margin: 0;
                display: inline-block;
                padding: 0.5rem 0;
            }

            .nav__mobile {
                display: block;
            }
        }
    </style>
</div>

<script is:inline>
    const navToggle = document.getElementById("navToggle");
    const mobileMenu = document.getElementById("mobileMenu");

    let toggleMobileMenu = () => {
        mobileMenu.classList.toggle("active");
        navToggle.classList.toggle("active");

        // Prevent body scrolling when menu is open
        if (mobileMenu.classList.contains("active")) {
            document.body.style.overflow = "hidden";
        } else {
            document.body.style.overflow = "";
        }
    };

    if (navToggle) {
        navToggle.addEventListener("click", toggleMobileMenu);
    }

    // Close menu when clicking on a link
    const mobileLinks = mobileMenu.querySelectorAll("a");
    mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu.classList.remove("active");
            navToggle.classList.remove("active");
            document.body.style.overflow = "";
        });
    });
</script>
