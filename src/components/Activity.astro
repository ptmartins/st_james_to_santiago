---
const { data } = Astro.props; 
const date = new Date(data.start_date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
});

const duration = new Date(data.elapsed_time * 1000).toISOString().substr(11, 8);
---

<div class="activity">
    <div class="activity__header">
        <div class="activity__date">{ date }</div> 
        { data.sport_type === 'Ride' ? <span class="activity__sport-type material-symbols-outlined" title="Cycle">directions_bike</span> : <span class="activity__sport-type material-symbols-outlined" title="Run">sprint</span> }
    </div>
    <div class="activity__content">
        <div class="activity__data activity--duration">
            <span class="activity__label material-symbols-outlined" title="Duration">access_time</span>
            <span>{ duration } </span>    
        </div>
        <div class="activity__data activity__distance"> 
            <span class="activity__label material-symbols-outlined" title="Distance">route</span>
            <span>{ Number(data.distance / 1000).toFixed(3) } Km</span>    
        </div>
        <div class="activity__data activity__avg-speed"> 
            <span class="activity__label material-symbols-outlined" title="Average speed">speed</span> 
            <span>{ data.avg_speed } km/h </span>
        </div>
        <div class="activity__data activity__elevation__gain"> 
            <span class="activity__label material-symbols-outlined" title="Altitude gain">altitude</span> 
            <span>{ data.total_elevation_gain } m</span>
        </div>
        {
            data.has_heartrate ? 
                <div class="activity__data activity__heart-rate">
                    <span class="activity__label material-symbols-outlined" title="Heart rate">cardiology</span>
                    <span>{ data.has_heartrate } bpm</span>
                </div> : null
        }
    </div>
    <div class="activity__footer">
        <a href={`https://www.strava.com/activities/${data.id}`} target="_blank" class="activity__link"> See on Strava</a>
    </div>
</div>

<style>
    .activity {
        background-color: var(--white);
        border-radius: var(--border-radius);
        color: #000;
        display: flex;
        flex-direction: column;
        font-size: 1.2rem;
        font-weight: 400;;
        padding: 1.5rem;
    }

    .activity__header {
        align-items: end;
        display: flex;
        justify-content: space-between;
        margin-block-end: 1.5rem;;
    }

    .activity__date {
        font-weight: 500;
    }

    .activity__sport-type {
        align-items: center;
        background-color: var(--black);
        border-radius: 6px;
        color: var(--white);
        display: flex;
        font-size: 2rem;
        height: 52px;
        justify-content: center;
        width: 52px;
    }

    .activity__content {
        flex-grow: 1;
    }

    .activity__data {
        align-items: center;
        display: flex;
        margin-block-end: .75rem;
    }

    .activity__label {
        align-items: center;
        background-color: var(--black);
        display: flex;
        color: var(--white);
        border-radius: 4px;;
        height: 36px;
        justify-content: center;
        margin-inline-end: .75rem;
        width: 36px;
    }

    .activity__footer {
        display: flex;
        justify-content: flex-end;
        margin-block-start: .75rem;
    }

    .activity__link {
        color: var(--black);
    }
</style>