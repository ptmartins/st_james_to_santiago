---
import calcCalories from "../utils/calcCalories";

const { data } = Astro.props; 
const date = new Date(data.start_date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
});
const time = new Date(data.start_date).toLocaleTimeString('en-US', {
    hour: '2-digit',
    minute: '2-digit'
});

const duration = new Date(data.elapsed_time * 1000).toISOString().substr(11, 8);
const durationHours = Number(data.elapsed_time / 3600).toFixed(3);
const calories = calcCalories(90, data.average_speed, durationHours);
---

<div class="activity">
    <div class="activity__content">
        <div class="activity__header">
            { 
                data.sport_type === 'Ride' ? 
                    <span class="activity__sport-type material-symbols-outlined" title="Cycle">directions_bike</span> : 
                    <span class="activity__sport-type material-symbols-outlined" title="Run">sprint</span> 
            }
            <div class="activity__dateTime">
                <div class="activity__date">{ date }</div> 
                <div class="activity__time">{ time }</div>
            </div>
        </div>
        <div class="activity__body">
            <div class="data data__stats">
                <div class="activity__data activity--duration">
                    <span class="activity__label" title="Duration">Duration</span>
                    <span class="activity__value">{ duration } </span>    
                </div>
                <div class="activity__data activity__distance"> 
                    <span class="activity__label" title="Distance">Distance</span>
                    <span class="activity__value">{ Number(data.distance / 1000).toFixed(3) } Km</span>    
                </div>
                <div class="activity__data activity__avg-speed"> 
                    <span class="activity__label" title="Average speed">Avg. speed</span> 
                    <span class="activity__value">{ data.avg_speed } km/h </span>
                </div>
                <div class="activity__data activity__elevation__gain"> 
                    <span class="activity__label" title="Altitude gain">Alt. gain</span> 
                    <span class="activity__value">{ data.total_elevation_gain } m</span>
                </div>
            </div>
            <div class="data data__health">
                {
                    data.has_heartrate ? 
                        <div class="activity__data activity__heart-rate">
                            <span class="activity__label material-symbols-outlined" title="Heart rate">cardiology</span>
                            <span>{ data.has_heartrate } bpm</span>
                        </div> : null
                }
                <div class="activity__data activity__calories">
                    <span class="activity__label material-symbols-outlined" title="Calories">mode_heat</span>
                    <span>{ calories} cal</span>
                </div>
            </div>
        </div>
        <div class="activity__footer">
            <a href={`https://www.strava.com/activities/${data.id}`} target="_blank" class="activity__link"> See on Strava</a>
        </div>
    </div>
</div>

<style>
    .activity {
        background-color: var(--glass);
        border: 1px solid #222;
        border-radius: var(--border-radius);
        box-shadow: 0 0 30px 0 rgba(0, 0, 0, .95);
        color: var(--white);
        display: flex;
        flex-direction: column;
        font-size: 14px;
        font-weight: 400;
        padding: 1.5rem;
        position: relative;
    }

    .activity__glass {
        background-color: rgba(0, 0, 0, .);
        filter: blur(4px);
        height: 100%;
        inset-block-start: 0;
        inset-inline-start: 0;
        position: absolute;
        width: 100%;
        z-index: 10;
    }

    .activity__header {
        display: flex;
        justify-content: space-between;
        margin-block-end: 1.5rem;;
    }

    .activity__date {
        font-size: 15px;
        font-weight: 600;
    }

    .activity__time{
        margin-block-start: .375rem;
        opacity: 0.5;
        text-align: end;
    }

    .activity__sport-type {
        align-items: center;
        background-color: var(--black);
        border-radius: 6px;
        color: var(--white);
        display: flex;
        font-size: 2rem;
        height: 52px;
        justify-content: center;
        width: 52px;
    }

    .activity__body {
    }

    .data {
        display: flex;
        gap: .75rem;
        justify-content: start;
    }

    .data__health {
        border-top: 1px solid rgba(255, 255, 255, .3);
        margin-block-start: 1.5rem;
        padding-block-start: .75rem;
    }

    .activity__data {
        flex: 0 0 calc(25% - 0.75rem);
    }

    .activity__label {
        align-items: center;
        display: flex;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 500;
        height: 36px;
        opacity: .5;
        width: 100%;
    }

    .activity__value {
        font-size: 17px;
        font-weight: 500;
    }

    .activity__heart-rate,
    .activity__calories {
        align-items: center;
        display: flex;
        flex: 0 0 33%;
        gap: .375rem;
    }

    .activity__heart-rate .activity__label,
    .activity__calories .activity__label {
        flex: 0 0 28px;
        font-size: 1.5rem;
    }

    .activity__footer {
        display: flex;
        font-size: 1rem;
        justify-content: flex-end;
        margin-block-start: .75rem;
    }

</style>