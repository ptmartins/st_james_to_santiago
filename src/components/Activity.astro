---
import calcCalories from "../utils/calcCalories";

const { data } = Astro.props; 
const date = new Date(data.start_date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
});
const time = new Date(data.start_date).toLocaleTimeString('en-US', {
    hour: '2-digit',
    minute: '2-digit'
});

const duration = new Date(data.elapsed_time * 1000).toISOString().substr(11, 8);
const durationHours = Number(data.elapsed_time / 3600).toFixed(3);
const calories = calcCalories(90, data.average_speed, durationHours);
---

<div class="activity">
    <div class="activity__content">
        { 
            data.sport_type === 'Ride' ? 
                <span class="activity__sport-type material-symbols-outlined" title="Cycle">directions_bike</span> : 
                <span class="activity__sport-type material-symbols-outlined" title="Run">sprint</span> 
        }
        <div class="activity__dateTime">
            <div class="activity__date">{ date }</div> 
            <div class="activity__time">{ time }</div>
        </div>

        <div class="activity__data activity__data--duration">
            <span class="activity__value">{ duration } </span>    
        </div>
        <div class="activity__data activity__data--distance"> 
            <span class="activity__value">{ Number(data.distance / 1000).toFixed(3) } Km</span>    
        </div>
        <div class="activity__data activity__data--avg-speed"> 
            <span class="activity__value">{ data.avg_speed } km/h </span>
        </div>
        <div class="activity__data activity__data--elevation-gain"> 
            <span class="activity__value">{ data.total_elevation_gain } m</span>
        </div>

        <div class="activity__data activity__data--calories">
            <span class="activity__value">{ calories} cal</span>
        </div>

            <a href={`https://www.strava.com/activities/${data.id}`} target="_blank" class="activity__link"> See on Strava</a>

    </div>
</div>

<style>
    .activity {
        background-color: var(--glass);
        border: 1px solid #222;
        border-radius: var(--border-radius);
        box-shadow: 0 4px 16px 0 rgba(0, 0, 0, .95);
        color: var(--white);
        font-size: 14px;
        font-weight: 400;
        margin-block-end: 1.5rem;
        padding: 1rem 1.5rem;
        position: relative;
    }

    .activity__glass {
        background-color: rgba(0, 0, 0, .);
        filter: blur(4px);
        height: 100%;
        inset-block-start: 0;
        inset-inline-start: 0;
        position: absolute;
        width: 100%;
        z-index: 10;
    }

    .activity__content {
        align-items: center;
        column-gap: 1.5rem;
        display: grid;
        grid-template-columns: 60px repeat(7, 1fr);
        grid-template-rows: minmax(30px, 1fr);
        justify-content: start;
        row-gap: .75rem;
    }

    .activity__sport-type {
        grid-area: 1 / 1 / 2 / 2;
    }

    .activity__data--duration {
        grid-area: 1 / 2 / 2 / 2;
    }

    .activity__data--distance {
        grid-area: 1 / 3 / 2 / 4;
    }

    .activity__data--avg-speed {
        grid-area: 1 / 4 / 2 / 5;
    }

    .activity__data--elevation-gain {
        grid-area: 1 / 5 / 2 / 6;
    }

    .activity__data--calories {
        grid-area: 1 / 6 / 2 / 7;
    }

    .activity__data--heart-rate {
        grid-area: 2 / 3 / 3 / 4;
    }

    .activity__dateTime {
        grid-area: 1 / 7 / 2 / 8;
    }

    .activity__link {
        grid-area: 1 / -2 / 2 / -1;
    }

    .activity__date {
        font-size: 15px;
        font-weight: 600;
    }

    .activity__sport-type {
        align-items: center;
        background-color: var(--accent);
        border-radius: 6px;
        color: var(--black);
        display: flex;
        font-size: 2rem;
        height: 52px;
        justify-content: center;
        width: 52px;
    }

    .data {
        display: flex;
        gap: .75rem;
        justify-content: start;
    }

    .data__health {
        border-top: 1px solid rgba(255, 255, 255, .3);
        margin-block-start: 1.5rem;
        padding-block-start: .75rem;
    }

    .activity__data {
        flex: 0 0 calc(25% - 0.75rem);
    }

    .activity__label {
        align-items: center;
        display: flex;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 500;
        height: 36px;
        opacity: .5;
        width: 100%;
    }

    .activity__value {
        font-size: 17px;
        font-weight: 500;
    }

    .activity__calories {
        align-items: center;
        display: flex;
        flex: 0 0 33%;
        gap: .375rem;
    }

</style>