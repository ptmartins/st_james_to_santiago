---
import '../styles/dashboardItem.css';

const { type, data } = Astro.props;
let label;
let subLabel;
let unit;
let icon;

switch(type.toLowerCase()) {
    case 'sessions':
        label = 'Sessions';
        subLabel = 'All time sessions';
        icon = 'calendar_month'
        break;
    case 'distance':
        label = 'Distance';
        subLabel = `Total Km's cycled`;
        unit = 'Km';
        icon = 'location_on';
        break;
    case 'duration':
        label = 'Duration';
        subLabel = 'Total training time';
        icon = 'schedule';
        break;
    case 'speed':
        label = 'Avg. Speed';
        subLabel = 'Overall average speed';
        unit= 'Km/h';
        icon = 'speed';
        break;
}
---

<div class="dashboardItem">
    <div class="content">
        <h3 class="label"> { label } </h3>
        <h2 class="data"> { data } <span class="unit"> { unit } </span> </h2>
        <p class="subLabel"> { subLabel } </p>
    </div>
    <div class="icon material-symbols-outlined"> { icon } </div>

</div>

