---
import Activity from '../components/Activity.astro';
const { activities } = Astro.props;
---

<ul class="activities">
  { activities.map(activity => (
    <Activity data={ activity } key={ activity.id } />
  ))}
</ul>

<style>
    .activities {
      max-height: 50vh
      overflow-y: auto;
    }

    .activities::-webkit-scrollbar {
      background-color: var(--glass);
      width: 14px;
    }

    .activities::-webkit-scrollbar-thumb {
      background-color: var(--accent);
      border-radius: 12px;
    }
</style>