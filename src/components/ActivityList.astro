---
import Activity from '../components/Activity.astro';
const { activities } = Astro.props;
---

<ul class="activities">
  { activities.map(activity => (
    <Activity data={ activity } key={ activity.id } />
  ))}
</ul>

<style>
    .activities {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
        gap: 3rem;
    }
</style>