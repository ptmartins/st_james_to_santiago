---
import { Calendar, MapPin, Clock, Zap } from 'lucide-static';

const { title, icon, value } = Astro.props;

// Map some Material icon names to Lucide equivalents
const iconMap: Record<string, string> = {
    'calendar_month': Calendar,
    'location_on': MapPin,
    'schedule': Clock,
    'speed': Zap,
};

const lucideIcon = iconMap[icon] ?? icon;
---

<div class="stat__item">
    <h3 class="stat__title"> {title} </h3>
    <div class="stat__content">
        <span class="stat__icon">
            <Fragment set:html={lucideIcon} />
        </span>
        <span class="stat__value"> {value} </span>
    </div>
</div>

<style>

    /* .stat__item {
        justify-self: start;
    } */
    .stat__title {
        color: var(--yellow);
        font-size: 1.3rem;
        font-weight: 500;
        margin-bottom: .75rem;
        opacity: .85;
        text-align: center;
    }

    .stat__content {
        align-items: center;
        display: flex;
        gap: .75rem;
    }

    .stat__icon {
        font-size: 3rem;
        opacity: .5;
    }

    /* Lucide SVG sizing */
    .stat__icon svg {
        width: 3rem;
        height: 3rem;
        opacity: .5;
        display: inline-block;
    }

    .stat__value {
        font-size: 2.7rem;
        font-weight: 600;
    }
</style>