---
import { CalendarClock, Route, SmartphoneCharging, Gauge, TrendingUp, MountainSnow } from 'lucide-static';

const { title, icon, value } = Astro.props;

// Map some Material icon names to Lucide equivalents
const iconMap: Record<string, string> = {
    'calendar_clock': CalendarClock,
    'route': Route,
    'energy': SmartphoneCharging,
    'speed': Gauge, 
    'altitude': TrendingUp, 
    'highest': MountainSnow, 
};

const lucideIcon = iconMap[icon] ?? icon;
---

<div class="stat__item">
    <div class="stat__header">
        <h3 class="stat__title"> {title} </h3>
        <span class="stat__icon">
            <Fragment set:html={lucideIcon} />
        </span>
    </div>
    <div class="stat__content">
        <span class="stat__value"> {value} </span>
    </div>
</div>

<style>

    .stat__item {
        background-color: #181818;
        border: 1px solid #222;
        border-radius: var(--border-radius);
        box-shadow: 0 0 20px 0 rgba(0, 0, 0, .98);
        color: var(--white);
        padding: 3rem;
        place-self: normal;
    }

    .stat__header {
        align-items: 
        color: var(--yellow);
        display: flex;
        justify-content: space-between;
        margin-block-end: .75rem;
    }

    .stat__title {
        font-size: 1.5em;
        font-weight: 500;
        opacity: .85;
    }

    .stat__content {
        align-items: center;
        display: flex;
        gap: .75rem;
    }

    .stat__icon {
        align-items: center;
        background-color: var(--yellow);
        border-radius: var(--border-radius);
        color: var(--black);
        display: flex;
        height: 48px;
        justify-content: center;
        width: 48px;
    }

    /* Lucide SVG sizing */
    .stat__icon svg {
        width: 3rem;
        height: 3rem;
        opacity: .5;
        display: inline-block;
    }

    .stat__value {
        font-size: 2.7rem;
        font-weight: 600;
    }
</style>